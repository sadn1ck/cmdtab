<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Keep the app unsandboxed for now: Accessibility APIs and window control are much simpler outside App Sandbox. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>

	<!-- Needed later if we use Apple Events to activate or script other apps. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
