# Copy to .env (gitignored) and uncomment to override. Autoloaded by just.
# These are the only tunable knobs; everything else is an internal constant.

# Build configuration; controls the .build/<configuration> output dir.
#CONFIGURATION=debug

# Path to the single self-signed code-signing .p12 (generated by `just cert`).
#CERT_P12=.secrets/cmdtab-codesign.p12

# Password protecting CERT_P12 and the local signing keychain.
#CERT_PASSWORD=
